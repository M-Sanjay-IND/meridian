{
  "name": "meridian",
  "version": "1.0.0",
  "description": "A campus scheduling engine for faculty office hours and lab slots",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:killer": "tsx tests/killer-tests/runner.ts",
    "test:concurrency": "tsx tests/concurrency/run.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^6.12.0",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "luxon": "^3.5.0",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
