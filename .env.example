# Meridian — every setting. No real secrets. Committed to the repo.

# ---- required
DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian
PORT=3000

# ---- scheduling windows. All overridable so a reviewer can test in minutes, not hours.
HOLD_TTL_MINUTES=10
MIN_NOTICE_MINUTES=0
MAX_BOOKINGS_PER_STUDENT_PER_WEEK=5
SLOT_RANGE_MAX_DAYS=31
TERM_HOLIDAYS=2026-10-20,2026-11-14

# ---- behaviour
ALLOCATION_POLICY=round-robin-week
DEFAULT_TIMEZONE=Asia/Kolkata
ENABLE_CLASH_SENTINEL=true
ENABLE_SUGGESTIONS=true
LOG_LEVEL=info

# ---- optional AI. Leave the key EMPTY: the app still runs and the concierge
# ---- falls back to its structured form. Nothing in the core path calls out.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- optional rate limiting ONLY. Never in the correctness path.
REDIS_URL=

# ---- optional email
SMTP_URL=
EMAIL_FROM=
